# --- Backend ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=postgresql+psycopg://saas:saas@localhost:5432/saas
CORS_ORIGINS=http://localhost:3000
# Where Stripe sends users back to after checkout / the billing portal.
FRONTEND_BASE_URL=http://localhost:3000

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Run `make sync-stripe-catalog` (with a real STRIPE_SECRET_KEY set) to create
# the Pro plan's product/price in Stripe and print its price ID for this var.
STRIPE_PRICE_ID_MONTHLY=price_placeholder

# --- Observability ---
# Leave both unset to run without error tracking (the default for local dev).
SENTRY_DSN=
VITE_SENTRY_DSN=
# Overrides the Sentry environment tag; defaults to the Vite build mode.
VITE_SENTRY_ENVIRONMENT=

# --- Operational alerting ---
# "log" (or its synonym "console") writes alerts to the structured log at a
# level a log-based monitor can watch; "webhook" POSTs them to an incoming
# webhook — a plain JSON body, which Slack renders directly and which
# PagerDuty's and Opsgenie's generic intakes accept as-is.
ALERT_BACKEND=log
ALERT_WEBHOOK_URL=
# Alerts below this severity are dropped: info | warning | critical.
ALERT_MIN_SEVERITY=warning
# How long the same alert stays suppressed after being delivered, so an
# outage that fires on every health probe doesn't flood the on-call channel.
ALERT_SUPPRESSION_SECONDS=300
ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# --- Usage analytics ---
# ANALYTICS_ENABLED=false stops recording new events; the summary endpoints
# keep answering from whatever is already stored.
ANALYTICS_ENABLED=true
# Events older than this are removed by `make prune-usage-events`.
ANALYTICS_RETENTION_DAYS=400
ANALYTICS_MAX_BATCH_SIZE=50

# --- API keys ---
# How long a revoked key's tombstone is kept before `make prune-api-keys`
# removes it. Long enough to answer "when did this stop working?".
API_KEY_RETENTION_DAYS=90

# --- Frontend ---
# Vite inlines this at build time, so changing it requires a rebuild of the
# frontend image / dev server, not just a restart.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Postgres (docker-compose) ---
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
