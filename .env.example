# --- Backend ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# bcrypt's cost factor. Keep this at 12 or higher in production; the test
# suite overrides it to a cheap value (see the Makefile) since it hashes a
# password in nearly every fixture and a hash stores its own cost factor, so
# lowering this never affects a password already hashed at a higher one.
BCRYPT_ROUNDS=12
DATABASE_URL=postgresql+psycopg://saas:saas@localhost:5432/saas
CORS_ORIGINS=http://localhost:3000
# Where Stripe sends users back to after checkout / the billing portal.
FRONTEND_BASE_URL=http://localhost:3000

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Run `make sync-stripe-catalog` (with a real STRIPE_SECRET_KEY set) to create
# the Pro plan's product/price in Stripe and print its price ID for this var.
STRIPE_PRICE_ID_MONTHLY=price_placeholder

# --- Observability ---
# Leave both unset to run without error tracking (the default for local dev).
SENTRY_DSN=
VITE_SENTRY_DSN=
# Overrides the Sentry environment tag; defaults to the Vite build mode.
VITE_SENTRY_ENVIRONMENT=

# --- Operational alerting ---
# "log" (or its synonym "console") writes alerts to the structured log at a
# level a log-based monitor can watch; "webhook" POSTs them to an incoming
# webhook — a plain JSON body, which Slack renders directly and which
# PagerDuty's and Opsgenie's generic intakes accept as-is.
ALERT_BACKEND=log
ALERT_WEBHOOK_URL=
# Alerts below this severity are dropped: info | warning | critical.
ALERT_MIN_SEVERITY=warning
# How long the same alert stays suppressed after being delivered, so an
# outage that fires on every health probe doesn't flood the on-call channel.
ALERT_SUPPRESSION_SECONDS=300
ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# --- Usage analytics ---
# ANALYTICS_ENABLED=false stops recording new events; the summary endpoints
# keep answering from whatever is already stored.
ANALYTICS_ENABLED=true
# Events older than this are removed by `make prune-usage-events`.
ANALYTICS_RETENTION_DAYS=400
ANALYTICS_MAX_BATCH_SIZE=50

# --- API keys ---
# How long a revoked key's tombstone is kept before `make prune-api-keys`
# removes it. Long enough to answer "when did this stop working?".
API_KEY_RETENTION_DAYS=90

# --- Sessions ---
# How long a dead sign-in session's row is kept before `make prune-sessions`
# removes it, counted from when it was revoked or expired. Shorter than the
# API key window: this list is one an account owner reads to recognise their
# own devices, and stale rows make the live ones harder to find.
SESSION_RETENTION_DAYS=30

# --- Audit trail ---
# How long security events (sign-ins and refusals, key and session changes,
# role and status changes) are kept before `make prune-audit-logs` removes
# them. Between the two windows above on purpose: long enough that an
# incident noticed months late still has a trail to reconstruct from, short
# enough that a record of where people were when they signed in is not held
# indefinitely to answer questions nobody is asking.
AUDIT_RETENTION_DAYS=180

# --- Outbound webhooks ---
# WEBHOOKS_ENABLED=false stops new deliveries being *queued*; anything
# already queued is still delivered, so turning it off stops new promises
# being made rather than abandoning the ones already made.
WEBHOOKS_ENABLED=true
# How long one unresponsive receiver may hold the delivery worker.
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# Deliveries attempted per pass of `make deliver-webhooks`. A bounded pass
# keeps the worker's runtime predictable; a backlog is worked through over
# several runs.
WEBHOOK_DELIVERY_BATCH_SIZE=50
# How long delivered and abandoned deliveries are kept before
# `make prune-webhook-deliveries` removes them. Pending rows are never
# pruned regardless of age — they are still owed to somebody.
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Permit http:// destinations and hosts that resolve to private addresses.
# For pointing an endpoint at a receiver on your own machine while building
# one. Leave this false in production: it re-opens the SSRF surface that
# backend/app/services/webhooks/urls.py exists to close.
WEBHOOK_ALLOW_INSECURE_URLS=false

# --- Frontend ---
# Vite inlines this at build time, so changing it requires a rebuild of the
# frontend image / dev server, not just a restart.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Postgres (docker-compose) ---
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
